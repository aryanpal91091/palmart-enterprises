# Port to run the Express Server
PORT=5000

# Database URL for PostgreSQL (Neon/Local/Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/palmart?schema=public"

# JWT Secrets for session tokens
JWT_ACCESS_SECRET="supersecretaccesstokensecretkey123!"
JWT_REFRESH_SECRET="supersecretrefreshtokensecretkey123!"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Cloudinary credentials for product image storage
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Nodemailer SMTP server config for receipts and notifications
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="smtp_username"
SMTP_PASS="smtp_password"
SMTP_FROM="no-reply@martpro.com"

# AI - optional Gemini API Key. If empty, fallback local statistics/NLP will run
GEMINI_API_KEY=""

# React frontend variables (referenced during build)
VITE_API_URL="http://localhost:5000/api"
